<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Parallax.Station.DesktopViewHost</AssemblyName>
    <RootNamespace>Parallax.Station.DesktopViewHost</RootNamespace>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\Parallax.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\Assets\Parallax.png"><Link>Assets\Parallax.png</Link></Resource>
  </ItemGroup>
</Project>
